# Copy to .env (or .env.local) and adjust.
#
# VITE_BOOKING_PREVIEW controls whether /richiedi-accesso.html shows the
# front-end-only beta booking flow (BetaBookingFlow) after a valid form
# submission, or the prudent "backend not connected" message from the base
# form behavior.
#
# true  -> full 8-step preview flow (application -> submitted -> review ->
#          approved -> date -> time -> summary -> confirmed). No network
#          calls are made, no data is persisted anywhere, and every screen
#          in the flow says plainly that it is a beta preview and that
#          nothing was actually sent, saved, or booked.
# false -> the original, prudent behavior: a valid submit shows the
#          existing "nessuna richiesta è stata inviata" message. Nothing is
#          simulated.
VITE_BOOKING_PREVIEW=false
